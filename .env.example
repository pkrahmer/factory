REPOS=<owner>/<repo>
GH_TOKEN=github_pat_...
# Optional: the identity the factory commits under; keep it a noreply address, never a personal one.
# The default matches no GitHub account. To have GitHub show the commits as yours, use your own
# noreply address, <id>+<login>@users.noreply.github.com; never <name>@users.noreply.github.com,
# which GitHub links to whoever owns the account <name>.
# GIT_USER_NAME=factory
# GIT_USER_EMAIL=factory@noreply.invalid
