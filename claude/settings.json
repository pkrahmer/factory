{
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(uv run *)",
      "Bash(factory-*)",
      "Bash(uv sync*)",
      "Bash(uv export*)",
      "Bash(make *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(date *)",
      "Bash(sed *)",
      "Bash(grep *)",
      "Bash(sleep *)",
      "Bash(curl *)",
      "Bash(pkill *)",
      "Bash(echo*)",
      "Bash(printf*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(which*)",
      "Bash(find*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(diff*)",
      "Bash(mkdir*)",
      "Bash(touch*)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(set -o pipefail)",
      "Bash(true)",
      "Bash(taskkill*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git branch -D*)",
      "Bash(gh *)",
      "Bash(rm -rf *)"
    ]
  }
}
